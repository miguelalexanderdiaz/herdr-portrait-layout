# Same rules as .gitattributes: UTF-8, LF line endings (also on Windows), a final newline, two spaces in JSON/JS/YAML.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[{LICENSE,NOTICE}]
trim_trailing_whitespace = false

[*.png]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
